{
  "meta": {
    "name": "Rikuy design system",
    "version": "1.0.0",
    "updated": "2026-10-20",
    "source_of_truth": "design/tokens.json. Everything else (kit/css/00-tokens.css, design.md, /design-system) is generated from this file by design/build_design.py.",
    "approach": "Mobile first. Base styles are for a 375 px phone; larger screens add with min-width media queries (480, 768, 1024, 1280)."
  },
  "color": {
    "brand": {
      "noche": {
        "value": "#14133F",
        "role": "Dark panels, primary text on light, buttons on light"
      },
      "noche-2": {
        "value": "#263962",
        "role": "Surfaces on noche, secondary text on light and on menta"
      },
      "menta": {
        "value": "#7FCCB4",
        "role": "Protagonist: alternating bands"
      },
      "teal": {
        "value": "#2E7D7C",
        "role": "Accents, links on light, footer, success"
      },
      "blanco": {
        "value": "#F6F9F8",
        "role": "Page background, text on dark"
      },
      "amarillo": {
        "value": "#DCE064",
        "role": "Highlight and primary call to action, 5 to 7 percent of any screen"
      }
    },
    "support": {
      "gris-tinta": {
        "value": "#5B5B74",
        "role": "Secondary text and metadata on light"
      },
      "hielo": {
        "value": "#A9B6D3",
        "role": "Secondary text on noche"
      },
      "bruma": {
        "value": "#CDD6E8",
        "role": "Body text on noche"
      },
      "menta-palida": {
        "value": "#BFE6DA",
        "role": "Soft light blobs and tints"
      },
      "papel": {
        "value": "#FBFBF7",
        "role": "Editorial paper background (investors, long reading)"
      }
    },
    "feedback": {
      "error": {
        "value": "#B42318",
        "role": "Invalid field, destructive action"
      },
      "error-bg": {
        "value": "#FDECEA",
        "role": "Invalid field background tint"
      },
      "success": {
        "value": "#2E7D7C",
        "role": "Valid field, confirmations (same as teal)"
      },
      "warning": {
        "value": "#DCE064",
        "role": "Notices, always with noche text"
      }
    }
  },
  "theme": {
    "note": "Surfaces set these CSS variables so one component reads right on any background.",
    "light": {
      "--hi": "#2E7D7C",
      "--hi-rgb": "46,125,124",
      "--hl": "#DCE064",
      "--muted": "#5B5B74",
      "--tq": "#2E7D7C"
    },
    "menta": {
      "--hi": "#14133F",
      "--hi-rgb": "20,19,63",
      "--muted": "#263962",
      "--tq": "#14133F"
    },
    "noche": {
      "--hi": "#DCE064",
      "--hi-rgb": "220,224,100",
      "--muted": "#A9B6D3",
      "--tq": "#DCE064"
    },
    "teal": {
      "--hi": "#F6F9F8",
      "--hi-rgb": "246,249,248",
      "--muted": "#F6F9F8",
      "--tq": "#DCE064"
    },
    "amarillo": {
      "--hi": "#14133F",
      "--hi-rgb": "20,19,63",
      "--muted": "#263962",
      "--tq": "#2E7D7C"
    }
  },
  "typography": {
    "families": {
      "display": {
        "value": "'Grift','Onest',system-ui,sans-serif",
        "role": "Titles, prices, numbers (weights 400, 500, 600, 700)"
      },
      "text": {
        "value": "'Onest',system-ui,sans-serif",
        "role": "Body, buttons, forms (300 to 700)"
      },
      "mono": {
        "value": "'JetBrains Mono',ui-monospace,monospace",
        "role": "Data, code, tool names, tags (400 to 600)"
      },
      "logo": {
        "value": "Drawn wordmark with the t'uqu tilde (SVG only). Use the files in /corporate/assets/",
        "role": "Logotype, never set in CSS"
      }
    },
    "scale": {
      "display": {
        "size": "clamp(34px,4.2vw + 18px,104px)",
        "line": "0.94",
        "tracking": "-0.048em",
        "weight": 600,
        "family": "display",
        "use": "H1 of every page"
      },
      "h2": {
        "size": "clamp(28px,3vw + 16px,60px)",
        "line": "1.02",
        "tracking": "-0.038em",
        "weight": 600,
        "family": "display",
        "use": "Section titles"
      },
      "h3": {
        "size": "clamp(20px,1vw + 16px,24px)",
        "line": "1.12",
        "tracking": "-0.02em",
        "weight": 600,
        "family": "display",
        "use": "Card titles"
      },
      "lead": {
        "size": "clamp(17px,.5vw + 15px,19px)",
        "line": "1.55",
        "tracking": "0",
        "weight": 400,
        "family": "text",
        "use": "Intro paragraph under a title"
      },
      "body": {
        "size": "16px",
        "line": "1.55",
        "tracking": "0",
        "weight": 400,
        "family": "text",
        "use": "Paragraphs, 17px from 768"
      },
      "small": {
        "size": "14.5px",
        "line": "1.5",
        "tracking": "0",
        "weight": 400,
        "family": "text",
        "use": "Nav links, table text, list items"
      },
      "caption": {
        "size": "13px",
        "line": "1.45",
        "tracking": "0",
        "weight": 400,
        "family": "text",
        "use": "Help text, footnotes. Never below 12px"
      },
      "data": {
        "size": "13px",
        "line": "1.5",
        "tracking": "0",
        "weight": 500,
        "family": "mono",
        "use": "Numbers, codes, tool names"
      }
    },
    "rules": [
      "No eyebrows: no small label above a title.",
      "Never below 12px for readable text.",
      "Numbers and prices use the display family; machine data uses mono.",
      "Titles never use Onest. Body never uses Grift."
    ]
  },
  "space": {
    "unit": "4px",
    "scale": {
      "0": "0",
      "1": "4px",
      "2": "8px",
      "3": "12px",
      "4": "16px",
      "5": "20px",
      "6": "24px",
      "7": "32px",
      "8": "40px",
      "9": "48px",
      "10": "64px",
      "11": "80px",
      "12": "96px"
    },
    "gutter": {
      "base": "16px",
      "640": "24px",
      "1024": "32px"
    },
    "section": {
      "value": "clamp(56px,8vw,96px)",
      "tight": "clamp(40px,5vw,56px)"
    },
    "wrap": "1240px"
  },
  "radius": {
    "xs": "8px",
    "sm": "12px",
    "md": "18px",
    "lg": "24px",
    "xl": "32px",
    "pill": "999px"
  },
  "shadow": {
    "glass": "0 1px 2px rgba(20,19,63,.04),0 24px 48px -28px rgba(20,19,63,.28)",
    "dark": "inset 0 1px 0 rgba(255,255,255,.12),0 30px 60px -30px rgba(0,0,0,.6)",
    "ring": "inset 0 0 0 1px rgba(20,19,63,.1)",
    "focus": "0 0 0 3px rgba(46,125,124,.35)"
  },
  "blur": {
    "glass": "22px",
    "dark": "20px",
    "frost": "14px"
  },
  "motion": {
    "ease": "cubic-bezier(.2,.7,.2,1)",
    "fast": "150ms",
    "base": "300ms",
    "slow": "600ms",
    "rules": [
      "Respect prefers-reduced-motion.",
      "Scroll reveals are optional enhancements; content is visible without them."
    ]
  },
  "breakpoint": {
    "note": "min-width, mobile first. CSS cannot read custom properties inside media queries, so these are documented here.",
    "sm": "480px",
    "md": "768px",
    "lg": "1024px",
    "xl": "1280px"
  },
  "layer": {
    "base": 0,
    "sticky": 20,
    "menu": 30,
    "toast": 40
  },
  "touch": {
    "min-target": "44px",
    "field-height": "52px",
    "button-height": "48px"
  },
  "material": {
    "note": "Glass is permission (marca/sistema-liquid-glass.md).",
    "glass": "Frosted light glass: floating UI above content (nav, cards on bands). Never behind long text on photos.",
    "glass-dark": "Noche glass: panels with code, chat, prices.",
    "solid": "Forms, tables and numbers sit on solid or near solid surfaces for legibility.",
    "tint": "Demo video and camera stills use the navy duotone filter #rk-navy (black to #14133F, white to #EAF0F8)."
  }
}