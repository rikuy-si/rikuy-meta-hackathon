# Copy to .env and fill in. Never commit .env.
# Nothing here is needed for the Quickstart (demo/run_poc.py and the tests run offline).

# --- Meta Model API (Muse Spark 1.3 answer in demo/animalx-gym/inference/src/rikuy_gym/report.py)
# Get a key at https://dev.meta.ai (API keys). Billing must be set up; hackathon credits show under Billing.
MUSE_BASE_URL=https://api.meta.ai/v1
MUSE_API_KEY=

# --- Gateway (apps/gateway). Empty tokens fall back to public dev tokens: set real ones outside local runs.
# RIKUY_STORE: local (built-in stand-in) | r2 | none
RIKUY_STORE=local
RIKUY_LOCAL_BASE=http://127.0.0.1:8000
RIKUY_ADMIN_TOKEN=
RIKUY_ACTOR_TOKEN=

# --- Cloudflare R2 (only when RIKUY_STORE=r2)
# Cloudflare dashboard → R2 → Manage API tokens (Object Read & Write on one bucket).
RIKUY_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
RIKUY_R2_BUCKET=rikuy-recordings
RIKUY_R2_ACCESS_KEY_ID=
RIKUY_R2_SECRET_ACCESS_KEY=
